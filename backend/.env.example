NODE_ENV=development
PORT=3001
HOST=127.0.0.1
API_PREFIX=/api
PUBLIC_BASE_URL=http://localhost:3001
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=sipat_portal
DATABASE_USER=sipat_app
DATABASE_PASSWORD=change-me
DATABASE_CONNECTION_LIMIT=10
DEFAULT_ORGANIZATION_SLUG=honda
DEFAULT_CAMPAIGN_SLUG=sipat-2026
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_NAME=sipat_refresh_token
CORS_ORIGINS=http://localhost:3000,https://khalifadeveloper.com.br
TRUST_PROXY=1
IP_HASH_SECRET=replace-with-an-independent-random-secret
PASSWORD_BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=5000
LOGIN_RATE_LIMIT_MAX=8
AUTHENTICATED_RATE_LIMIT_WINDOW_MS=60000
ATTENDANCE_RATE_LIMIT_MAX=10
VIDEO_PROGRESS_RATE_LIMIT_MAX=12
QUIZ_RATE_LIMIT_MAX=5
HONEYPOT_BLOCK_MS=3600000
LOG_LEVEL=info
SWAGGER_ENABLED=true
UPLOAD_DIR=storage/uploads
# Opcional: origem/CDN que publique exatamente /api/uploads/* do UPLOAD_DIR.
MEDIA_PUBLIC_BASE_URL=
MAX_UPLOAD_IMAGE_MB=10
MAX_UPLOAD_VIDEO_MB=500
EMAIL_MODE=outbox
EMAIL_OUTBOX_DIR=storage/outbox
EMAIL_FROM=noreply@localhost.test
EMAIL_FROM_NAME=Portal SIPAT
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
BOOTSTRAP_ADMIN_EMPLOYEE=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-running-bootstrap
